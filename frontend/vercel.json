{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://eie-cochabamba.sytes.net/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://eie-cochabamba.sytes.net/storage/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
