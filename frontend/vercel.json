{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://10.10.11.222:8000/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "http://10.10.11.222:8000/storage/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
