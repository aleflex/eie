{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://eie-backend-9n36.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://eie-backend-9n36.onrender.com/storage/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
